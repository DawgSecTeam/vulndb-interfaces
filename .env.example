DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=

MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=vulndb-attachments

# Optional — DB backups. The server runs `mysqldump`/`mysql` (or `mariadb-dump`/`mariadb`) as
# local child processes, so those client tools must be installed on the host running server.js.
# BACKUP_DIR defaults to ~/.vulndb-backups (created with mode 700) if unset. It must never be
# under public/ — the server refuses to start if it resolves there. If BACKUP_DIR isn't set in
# .env at all, the server writes the resolved default back into .env on first startup so it's
# on record instead of only living in memory.
# BACKUP_CRON defaults to "0 3 * * *" (daily at 3am); set to "off" to disable scheduled backups.
# BACKUP_RETENTION defaults to 30 — that many of the most recent backups are kept, older ones
# are deleted automatically after each successful backup.
BACKUP_DIR=
BACKUP_CRON=
BACKUP_RETENTION=
